
def caching_fibonacci():
    # Створюємо кеш для збереження результатів
    cache = {}

    def fibonacci(n):
        # Перевіряємо базові випадки
        if n <= 0:
            return 0
        if n == 1:
            return 1

        # Перевіряємо, чи є число в кеші
        if n in cache:
            return cache[n]

        # Обчислюємо число Фібоначчі рекурсивно
        cache[n] = fibonacci(n - 1) + fibonacci(n - 2)

        return cache[n]

    return fibonacci


# Отримуємо функцію fibonacci
fib = caching_fibonacci()

# Перевіряємо роботу функції
print(fib(10))  # 55
print(fib(15))  # 610
print(fib(20))  # 6765
